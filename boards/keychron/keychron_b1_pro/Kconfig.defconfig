# SPDX-License-Identifier: MIT

if BOARD_KEYCHRON_B1_PRO

config BOARD
    default "keychron_b1_pro"

config ZMK_KEYBOARD_NAME
    default "Keychron B1 Pro"

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config BT_CTLR
    default BT

# Keychron's own board enables DC/DC unconditionally (Keychron/zmk
# keychron_bpro, app/boards/arm/keychron/Kconfig), so the inductor is fitted.
config BOARD_ENABLE_DCDC
    bool "Enable DCDC mode"
    select SOC_DCDC_NRF52X
    default y

endif # BOARD_KEYCHRON_B1_PRO
