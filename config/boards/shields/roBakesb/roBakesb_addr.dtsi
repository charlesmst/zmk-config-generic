/*
 * Shared ESB link identity for the roBakesb dongle and all peripherals.
 * Every side must include the same base address, channel set, and peripheral
 * table. Each peripheral overlay selects its own entry with zmk,esb-self.
 * The trackball_listener is disabled here; the dongle overlay enables it.
 * The right peripheral overlay assigns device = <&trackball> to trackball_split.
 * The lariska peripheral assigns device = <&mou0> to mouse_split.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    esb_link: esb_link {
        compatible = "zmk,split-esb";
        base-address = [E7 E3 A7 E8];
        address-length = <4>;
        hop-channels = [18 31 4A 50];
        hop-threshold = <16>;

        peripherals {
            esb_left: peripheral_left {
                pipe = <0>;
                prefix = <0xE7>;
                weight = <1>;
            };

            esb_right: peripheral_right {
                pipe = <1>;
                prefix = <0xE6>;
                weight = <1>;
            };

            esb_lariska: peripheral_lariska {
                pipe = <2>;
                prefix = <0xE5>;
                weight = <1>;
            };

            /* HID relay dongle. Only used by the right-central topology
             * (roBakesb_right_central + roBakesb_relay), so it stays disabled
             * here and each of those two overlays sets it okay. A disabled
             * child is skipped by DT_FOREACH_CHILD_STATUS_OKAY, so the
             * dongle-central builds keep the same three-pipe link they had. */
            esb_relay: peripheral_relay {
                pipe = <3>;
                prefix = <0xE4>;
                weight = <1>;
                role = "relay";
                status = "disabled";
            };
        };

        tx-power-dbm = <8>;
        retransmit-count = <8>;
        retransmit-delay-us = <600>;
        use-fast-ramp-up;
        bitrate-kbps = <2000>;
        /* Pointer motion goes out noack -- fire-and-forget, no retransmit, so
         * a lost packet loses that delta outright. Mouse buttons and scroll
         * stay ACK'd; only the two relative axes are lossy.
         *
         * This is back on as a diagnostic, not as a preference. Lossless
         * motion is the better default here -- a dropped delta is lost
         * cursor travel, and v0.8.6's running totals heal it on the next tick
         * only for axes that are actually declared lossy, which is what this
         * line does. What it buys right now is that it takes motion out of
         * the retransmit budget entirely: a motion batch can no longer burn
         * up to retransmit-count=8 at 600us, so if the relay's remaining
         * failures and the pointer stutter are a TX-FIFO backlog under fast
         * movement, they should change shape or go away. If they do not, the
         * uplink is not where the problem is.
         *
         * It also turns the two v0.8.8/v0.8.9 commits that were inert in this
         * rig into live code, which is the other half of the reason to try
         * it. Nothing here sent fire-and-forget before, so no hop window had
         * a noack packet to exclude from its grade (5b423da) and the
         * central's pipes_acked always equalled the old pipes_seen (e989fd4).
         * Both now do real work on the halves' motion traffic.
         *
         * Payload consequence, and it is the one roBakesb_lariska.conf and
         * west.yml both warned about: declaring lossy axes makes
         * PERIPHERAL_MOTION_TOTALS_MAX non-zero, so the v0.8.6 keepalive
         * carries 4 bytes per lossy axis (ESB_KEEPALIVE_MOTION_BYTES) on top
         * of the count byte -- 8 for the two here. Lariska, the tightest node,
         * goes from 45 to 53 bytes.
         * That still fits the rig-wide 56, but it no longer fits 48 -- the
         * 56 is now load-bearing rather than headroom, and dropping it back
         * would fail the keepalive BUILD_ASSERT. Those comments are updated
         * to say so.
         *
         * Revert this hunk (and the comments that reference it) to go back to
         * a fully lossless uplink.
         */
        lossy-codes
            = <INPUT_EV_REL INPUT_REL_X>
            , <INPUT_EV_REL INPUT_REL_Y>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };

        mouse_split: mouse_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
            status = "disabled";
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };

    /* Defined here so all targets (dongle + every peripheral) resolve
     * &stepped_scroll from the shared roBakesb.keymap. The dongle's overlay
     * also adds stepped_scroll_il which routes the events to HID. */
    stepped_scroll: stepped_scroll {
        compatible = "zmk,behavior-stepped-scroll";
        #binding-cells = <1>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* Horizontal variant of stepped_scroll for the MB4-hold scroll layer.
     * Routed to HID by stepped_hscroll_il in the dongle overlay. */
    stepped_hscroll: stepped_hscroll {
        compatible = "zmk,behavior-stepped-scroll";
        #binding-cells = <1>;
        input-code = <INPUT_REL_HWHEEL>;
    };
};
